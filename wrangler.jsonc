{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "idol-id",
  "main": "./worker/entry.js",
  "compatibility_date": "2026-08-29",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "hermes.idol.id/*", "zone_name": "idol.id" },
    { "pattern": "claw.idol.id/*", "zone_name": "claw.idol.id" }
  ],
  "vars": {
    "IDOL_AUTHORITY": "cb2199dff026c1b2d3fbd0caa04d6d323370a9e8",
    "IDOL_NATIVE_AUTHORITY": "ad438a856daa8786e77ac9f033d38deb9e8f5c29",
    "IDOL_SOURCE_LAW": "95e70291b13062881ebc6c96005c5ad02230bf5b5a7e62ced4f6e8787ab4993b",
    "IDOL_LOCAL_DEVELOPMENT": "1"
  },
  "observability": { "enabled": true }
}
